# ------------------------- HTTP обработчик -------------------------

class Handler(http.server.BaseHTTPRequestHandler):

    def log_message(self, *args):
        pass  # тихий лог

    # ---- утилиты ----
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body, ensure_ascii=False)
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_json(self):
        n = int(self.headers.get("Content-Length") or 0)
        if not n:
            return {}
        return json.loads(self.rfile.read(n).decode("utf-8"))

    # ---- GET ----
    def do_GET(self):
        u = urlparse(self.path)
        p, qs = u.path, parse_qs(u.query)

        if p == "/":
            return self._send(200, HTML_PAGE, "text/html")

        if p == "/api/workouts":
            con = db()
            try:
                rows = [dict(r) for r in con.execute("SELECT * FROM workouts ORDER BY id DESC")]
            finally:
                con.close()
            return self._send(200, rows)

        if p == "/api/schedule":
            con = db()
            try:
                if "day" in qs:
                    rows = [dict(r) for r in con.execute("""
                        SELECT s.id, s.day, s.time, s.workout_id, w.name
                        FROM schedule s JOIN workouts w ON w.id = s.workout_id
                        WHERE s.day = ? ORDER BY s.time
                    """, (qs["day"][0],))]
                else:
                    month = qs.get("month", [""])[0]
                    rows = [dict(r) for r in con.execute("""
                        SELECT s.id, s.day, s.time, s.workout_id, w.name
                        FROM schedule s JOIN workouts w ON w.id = s.workout_id
                        WHERE s.day LIKE ? ORDER BY s.day, s.time
                    """, (month + "%",))]
            finally:
                con.close()
            return self._send(200, rows)

        if p == "/api/reminders":
            con = db()
            try:
                rows = [dict(r) for r in con.execute("SELECT * FROM reminders ORDER BY due")]
            finally:
                con.close()
            return self._send(200, rows)

        if p == "/api/notifications":
            now = datetime.now().strftime("%Y-%m-%dT%H:%M")
            con = db()
            try:
                rows = [dict(r) for r in con.execute(
                    "SELECT id, title, due FROM reminders WHERE notified = 0 AND due <= ?", (now,))]
                for r in rows:
                    con.execute("UPDATE reminders SET notified = 1 WHERE id = ?", (r["id"],))
                con.commit()
            finally:
                con.close()
            return self._send(200, rows)

        return self._send(404, {"error": "not found"})

    # ---- POST ----
    def do_POST(self):
        p = urlparse(self.path).path
        data = self._read_json()
        con = db()
        try:
            if p == "/api/workouts":
                name = (data.get("name") or "").strip()
                if not name:
                    return self._send(400, {"error": "Введите название программы"})
                cur = con.execute("INSERT INTO workouts(name, details) VALUES(?, ?)",
                                  (name, (data.get("details") or "").strip()))
                con.commit()
                return self._send(200, {"id": cur.lastrowid})

            if p == "/api/schedule":
                day = (data.get("day") or "").strip()
                wid = data.get("workout_id")
                if not day or not wid:
                    return self._send(400, {"error": "Нужны дата и тренировка"})

                # Фикс А: отсекаем мусор и неположительные ID
                try:
                    wid = int(wid)
                    if wid <= 0:
                        raise ValueError
                except (TypeError, ValueError):
                    return self._send(400, {"error": "Некорректный ID тренировки"})

                # Фикс Б: ловим нарушение внешнего ключа (несуществующая программа)
                try:
                    cur = con.execute(
                        "INSERT INTO schedule(day, time, workout_id) VALUES(?, ?, ?)",
                        (day, (data.get("time") or "").strip(), wid),
                    )
                    con.commit()
                except sqlite3.IntegrityError:
                    return self._send(400, {"error": "Такой программы не существует"})

                return self._send(200, {"id": cur.lastrowid})

            if p == "/api/reminders":
                title = (data.get("title") or "").strip()
                due = (data.get("due") or "").strip()
                if not title or not due:
                    return self._send(400, {"error": "Нужны заголовок и время"})
                cur = con.execute("INSERT INTO reminders(title, due, notified) VALUES(?, ?, 0)",
                                  (title, due))
                con.commit()
                return self._send(200, {"id": cur.lastrowid})
        finally:
            con.close()
        return self._send(404, {"error": "not found"})

    # ---- DELETE ----
    def do_DELETE(self):
        parts = urlparse(self.path).path.strip("/").split("/")
        tables = {"workouts": "workouts", "schedule": "schedule", "reminders": "reminders"}
        if len(parts) == 3 and parts[0] == "api" and parts[1] in tables:
            try:
                row_id = int(parts[2])
            except (TypeError, ValueError):
                return self._send(400, {"error": "Некорректный ID"})

            con = db()
            try:
                con.execute(f"DELETE FROM {tables[parts[1]]} WHERE id = ?", (row_id,))
                con.commit()
            finally:
                con.close()
            return self._send(200, {"ok": True})

        return self._send(404, {"error": "not found"})


# ------------------------- Запуск -------------------------

class ThreadingServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    init_db()

    port = START_PORT
    srv = None
    for _ in range(20):
        try:
            srv = ThreadingServer((HOST, port), Handler)
            break
        except OSError:
            port += 1
    if srv is None:
        print("Не удалось занять порт")
        return

    url = "http://%s:%d/" % (HOST, port)
    print("Сервер запущен:", url)
    print("Ctrl+C для остановки")
    threading.Timer(0.8, lambda: webbrowser.open(url)).start()

    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nОстановлено")
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
