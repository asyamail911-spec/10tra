  e.preventDefault();
  const f = e.target;
  await api('/api/workouts', 'POST', { name: f.name.value, details: f.details.value });
  f.reset();
  loadWorkouts();
};

/* ---------- Календарь ---------- */
let cur = new Date();
let workoutsCache = [];
let selectedDay = null;

const DOW = ['ПН','ВТ','СР','ЧТ','ПТ','СБ','ВС'];
$('#dowRow').innerHTML = DOW.map(d => `<div class="dow">${d}</div>`).join('');

function ymd(d){
  return d.getFullYear() + '-' +
         String(d.getMonth()+1).padStart(2,'0') + '-' +
         String(d.getDate()).padStart(2,'0');
}

async function loadCalendar(){
  workoutsCache = await api('/api/workouts');

  const y = cur.getFullYear(), m = cur.getMonth();
  const monthStr = y + '-' + String(m+1).padStart(2,'0');
  $('#monthLabel').textContent = cur.toLocaleDateString('ru', {month:'long', year:'numeric'});

  const events = await api('/api/schedule?month=' + monthStr);
  const byDay = {};
  events.forEach(e => { (byDay[e.day] = byDay[e.day] || []).push(e); });

  const first = new Date(y, m, 1);
  const offset = (first.getDay() + 6) % 7;          // неделя с понедельника
  const days = new Date(y, m+1, 0).getDate();
  const todayStr = ymd(new Date());

  let html = '';
  for (let i = 0; i < offset; i++) html += '<div class="day empty"></div>';
  for (let d = 1; d <= days; d++){
    const ds = y + '-' + String(m+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
    const evs = byDay[ds] || [];
    html += `<div class="day ${ds === todayStr ? 'today' : ''}" data-day="${ds}">
      <div class="num">${d}</div>
      ${evs.map(e => `<div class="ev" title="${esc(e.name)}">${e.time ? esc(e.time) + ' ' : ''}${esc(e.name)}</div>`).join('')}
    </div>`;
  }
  $('#calGrid').innerHTML = html;
  document.querySelectorAll('.day[data-day]').forEach(el => {
    el.onclick = () => openDay(el.dataset.day);
  });
}

async function openDay(day){
  selectedDay = day;
  const evs = await api('/api/schedule?day=' + day);
  const opts = workoutsCache.map(w => `<option value="${w.id}">${esc(w.name)}</option>`).join('');

  const list = evs.length ? evs.map(e => `
    <div class="card">
      <div><h3>${e.time ? esc(e.time) + ' — ' : ''}${esc(e.name)}</h3></div>
      <button class="ghost" onclick="delEvent(${e.id})">Удалить</button>
    </div>`).join('') : '<p class="empty">Нет тренировок в этот день</p>';

  const d = new Date(day + 'T00:00:00');
  const panel = $('#dayPanel');
  panel.innerHTML = `
    <h2>${d.toLocaleDateString('ru', {day:'numeric', month:'long', year:'numeric'})}</h2>
    ${list}
    ${workoutsCache.length ? `
      <form id="dayForm">
        <select name="workout_id">${opts}</select>
        <input type="time" name="time" value="18:00">
        <button type="submit">Добавить</button>
      </form>` : '<p class="empty">Сначала создайте программу во вкладке «Программы»</p>'}
  `;
  panel.classList.remove('hidden');

  const f = $('#dayForm');
  if (f) f.onsubmit = async e => {
    e.preventDefault();
    await api('/api/schedule', 'POST', {
      day: day,
      time: f.elements['time'].value,
      workout_id: f.elements['workout_id'].value
});
    await loadCalendar();
    openDay(day);
  };
}

window.delEvent = async id => {
  await api('/api/schedule/' + id, 'DELETE');
  await loadCalendar();
  if (selectedDay) openDay(selectedDay);
};

$('#prevM').onclick = () => { cur.setMonth(cur.getMonth() - 1); loadCalendar(); };
$('#nextM').onclick = () => { cur.setMonth(cur.getMonth() + 1); loadCalendar(); };

/* ---------- Напоминания ---------- */
async function loadReminders(){
  const list = await api('/api/reminders');
  $('#rList').innerHTML = list.length ? list.map(r => {
    const dt = new Date(r.due);
    return `<div class="card">
      <div>
        <h3>${esc(r.title)}</h3>
        <p>${dt.toLocaleString('ru', {day:'numeric', month:'long', hour:'2-digit', minute:'2-digit'})}${r.notified ? ' · отправлено' : ''}</p>
      </div>
      <button class="ghost" onclick="delReminder(${r.id})">Удалить</button>
    </div>`;
  }).join('') : '<p class="empty">Пока нет напоминаний</p>';
}

window.delReminder = async id => {
  await api('/api/reminders/' + id, 'DELETE');
  loadReminders();
};

$('#rForm').onsubmit = async e => {
  e.preventDefault();
  const f = e.target;
  await api('/api/reminders', 'POST', { title: f.title.value, due: f.due.value });
  f.reset();
  loadReminders();
};


/* ---------- Оповещения ---------- */
if ('Notification' in window && Notification.permission === 'default'){
  Notification.requestPermission();
}

async function pollNotifications(){
  try {
    const due = await api('/api/notifications');
    if (!due.length) return;

    if ('Notification' in window && Notification.permission === 'granted'){
      due.forEach(r => new Notification('Тренировка', { body: r.title }));
    } else {
      alert('Напоминания:\n' + due.map(r => '• ' + r.title).join('\n'));
    }
    loadReminders();
  } catch(e) { /* сервер недоступен — молча ждём */ }
}

/* ---------- Инициализация ---------- */
loadWorkouts();
loadCalendar();
loadReminders();
setInterval(pollNotifications, 15000);
pollNotifications();
