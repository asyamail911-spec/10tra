/* ---------- Программы тренировок ---------- */
async function loadWorkouts(){
  const list = await api('/api/workouts');
  $('#wList').innerHTML = list.length ? list.map(w => `
    <div class="card">
      <div><h3>${esc(w.name)}</h3>${w.details ? `<p>${esc(w.details)}</p>` : ''}</div>
      <button class="ghost" onclick="delWorkout(${w.id})">Удалить</button>
    </div>`).join('') : '<p class="empty">Пока нет программ</p>';
}

